# Address the BROWSER uses to reach this host.
#
# Docker Compose substitutes this into docker-compose.yml. The frontend bakes
# it into the bundle it serves, and both backends add it to their CORS allow
# list, so it has to be an address the viewer's machine can actually reach.
#
#   Local development ......... 127.0.0.1
#   Hosted on EC2 ............. the instance's public IPv4 address
#
# Copy this file to .env and set the value. Compose reads .env automatically.
HOST_ADDRESS=127.0.0.1
