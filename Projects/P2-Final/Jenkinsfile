pipeline {

    agent { label 'linux' }


    tools {
        // Configured in the UI against /opt/java/temurin-17, which
        // infra/agent/user-data.sh installs. Not the agent's own JVM: that is 21,
        // because the controller image is lts-jdk21 and remoting ships class file 65.
        jdk 'temurin-17'
    }

    environment {
        JWT_SECRET           = credentials('jwt-secret')
        JWT_EXPIRATION_HOURS = '8'

        // Offset from 5000/7001/8080 so CI does not fight anything else on the host.
        EMPLOYEE_PORT = '15000'
        MANAGER_PORT  = '17001'
        FRONTEND_PORT = '18080'

        // CI-only project name, so `down -v` cannot touch another stack.
        COMPOSE_PROJECT_NAME = 'em-ci'

        // Throwaway Postgres for the unit/DAO/integration suites, which run
        // before the stack is up and must not share its data.
        //
        // Started by hand rather than via Testcontainers. On this Linux agent
        // Testcontainers would work -- the named-pipe failure that forced this
        // on Windows does not exist here -- but an explicit container needs no
        // ryuk sidecar and makes a startup failure obvious in the stage log.
        // TestPostgres still falls back to Testcontainers wherever
        // TEST_POSTGRES_URL is unset, so developers are unaffected either way.
        TEST_DB_NAME     = 'em-ci-test-db'
        // 5434: clear of the native 5432 and the developer stack's 5433.
        TEST_DB_PORT     = '5434'
        TEST_POSTGRES_URL      = 'jdbc:postgresql://localhost:5434/expense_manager'
        TEST_POSTGRES_USER     = 'expense'
        TEST_POSTGRES_PASSWORD = 'expense'

        REGISTRY = 'ghcr.io/qea2026'
        // Immutable per-commit tag; never `latest`, so a box's version is knowable.
        IMAGE_TAG = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'dev'}"

        // ec2-user on Amazon Linux; ubuntu on Ubuntu AMIs.
        DEPLOY_USER = "${params.DEPLOY_USER}"
        DEPLOY_HOST = "${params.DEPLOY_HOST}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        // Fires on GitHub's push webhook, posted to /github-webhook/ (trailing slash
        // required). Only registers at the END of a build, so a UI config save drops
        // it until the next manual run.
        githubPush()
        // Belt and braces: webhooks are fire-and-forget and GitHub does not retry
        // forever, so this catches a push delivered while Jenkins was restarting.
        pollSCM('H H/4 * * *')
    }

    parameters {
        // Off by default: the suite adds ~4 min and reseeds the database.
        booleanParam(name: 'RUN_LOAD_TESTS', defaultValue: false,
                     description: 'Run the JMeter load suite after the e2e tests.')

        // On by default: this job only builds main, and a green main deploys.
        // Untick it in Build with Parameters for a test-only run.
        booleanParam(name: 'DEPLOY', defaultValue: true,
                     description: 'Push images to GHCR and deploy them to the EC2 host.')

        // Destructive: db-init deletes and rebuilds. Required on the first deploy only.
        booleanParam(name: 'SEED_REMOTE_DB', defaultValue: false,
                     description: 'WIPES the deployed database and reseeds it. First deploy only.')

        // A parameter, not a constant: the public IP changes on stop/start
        // unless an Elastic IP is attached.
        string(name: 'DEPLOY_HOST', defaultValue: '18.116.165.206',
               description: 'Public IP or DNS of the deployment host.')

        string(name: 'DEPLOY_USER', defaultValue: 'ec2-user',
               description: 'SSH login for the deployment host.')
    }

    stages {
        // No checkout stage: SCM mode clones before this file is evaluated.

        stage('Clean reports') {
            steps {
                // All four suites merge into one allure-results, so wipe once here.
                sh 'rm -rf allure-results allure-report htmlcov pytest-results.xml'
            }
        }

        stage('Test database') {
            steps {
                // Defensive: a build killed mid-run leaves the container behind.
                sh returnStatus: true, script: 'docker rm -f "$TEST_DB_NAME"'

                sh '''
                    docker run -d --name "$TEST_DB_NAME" -p "$TEST_DB_PORT":5432 \
                      -e POSTGRES_DB=expense_manager \
                      -e POSTGRES_USER="$TEST_POSTGRES_USER" \
                      -e POSTGRES_PASSWORD="$TEST_POSTGRES_PASSWORD" \
                      postgres:17-alpine
                '''

                sh '''
                    tries=0
                    until docker exec "$TEST_DB_NAME" \
                            pg_isready -U "$TEST_POSTGRES_USER" -d expense_manager >/dev/null 2>&1; do
                        tries=$((tries + 1))
                        if [ "$tries" -ge 60 ]; then
                            echo "Test database never became ready"
                            exit 1
                        fi
                        sleep 2
                    done
                    echo "Test database ready on port $TEST_DB_PORT"
                '''
            }
        }

        stage('Test') {
            parallel {
                stage('Java') {
                    steps {
                        dir('manager-app') {
                            // `test` not `verify` (jmeter binds to verify); phase not goal (JaCoCo sets argLine).
                            sh 'mvn -B test'
                        }
                    }
                }

                stage('Python') {
                    steps {
                        sh '''
                            # python3-ci, not python3: AL2023's default is 3.9 and psycopg needs >= 3.10.
                            [ -d .venv ] || python3-ci -m venv .venv
                            .venv/bin/python -m pip install -r requirements.txt \
                                --quiet --disable-pip-version-check
                            .venv/bin/python -m pytest --junitxml=pytest-results.xml
                        '''
                    }
                }
            }
        }

        // Explicit -f flags, not COMPOSE_FILE: its separator is OS-specific.

        stage('Build images') {
            steps {
                // compose build, so contexts stay declared in one place.
                sh 'docker compose -f compose.yaml -f compose.ci.yaml build'
            }
        }

        stage('Seed database') {
            steps {
                // Defensive: a build killed mid-run leaves containers and a volume.
                sh returnStatus: true,
                   script: 'docker compose -f compose.yaml -f compose.ci.yaml down -v --remove-orphans'

                // One-shot seeder; deletes and rebuilds the DB, so it runs before serving.
                sh 'docker compose -f compose.yaml -f compose.ci.yaml --profile init run --rm db-init'
            }
        }

        stage('Stack up') {
            steps {
                // --wait blocks on healthchecks; depends_on alone only waits for start.
                sh 'docker compose -f compose.yaml -f compose.ci.yaml up -d --wait'
            }
        }

        stage('Smoke test') {
            steps {
                // Direct to the APIs: the frontend bundle hardcodes 127.0.0.1:5000/:7001.
                sh 'curl --fail --silent --show-error "http://localhost:$MANAGER_PORT/health"'
                sh 'curl --fail --silent --show-error "http://localhost:$EMPLOYEE_PORT/health"'
                sh 'curl --fail --silent --show-error --output /dev/null "http://localhost:$FRONTEND_PORT/"'
            }
        }

        stage('E2E') {
            environment {
                // DatabaseState shells out to `docker compose exec -T db-tools`
                // from the repo root; this is how that subprocess finds both files.
                // ':' is the separator everywhere except Windows.
                COMPOSE_FILE = 'compose.yaml:compose.ci.yaml'
            }
            steps {
                dir('e2e-tests') {
                    // headless: this agent has no display, and Chrome will not start without one.
                    // One URL: every API call goes through the frontend's proxy.
                    sh 'mvn -B test -De2e.headless=true -De2e.base.url="http://127.0.0.1:$FRONTEND_PORT/"'
                }
            }
        }

        // After E2E: seeding for load replaces the baseline the e2e reset restores.
        stage('Load test') {
            when { expression { params.RUN_LOAD_TESTS } }
            steps {
                // Every run consumes the pending rows, so this is per-run, not setup.
                sh 'docker compose -f compose.yaml -f compose.ci.yaml exec -T db-tools python /app/dbsetup/seed_load.py'

                dir('load-tests') {
                    // `clean`: JMeter refuses to write into a non-empty report dir.
                    sh '''
                        mvn -B clean verify \
                            -Dmanager.host=127.0.0.1 -Dmanager.port="$MANAGER_PORT" \
                            -Demployee.host=127.0.0.1 -Demployee.port="$EMPLOYEE_PORT"
                    '''
                }
            }
        }

        stage('Publish images') {
            when { expression { params.DEPLOY } }
            steps {
                // Images were already tagged for the registry by `compose build`.
                withCredentials([usernamePassword(credentialsId: 'ghcr',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_TOKEN')]) {
                    // Single-quoted on purpose: Groovy interpolation would bake the
                    // token into the script text, where Jenkins cannot mask it.
                    // --password-stdin for the same reason argv would leak it to `ps`.
                    sh 'echo "$REG_TOKEN" | docker login ghcr.io -u "$REG_USER" --password-stdin'
                }
                sh 'docker push "$REGISTRY/expense-db-init:$IMAGE_TAG"'
                sh 'docker push "$REGISTRY/expense-employee-api:$IMAGE_TAG"'
                sh 'docker push "$REGISTRY/expense-manager-api:$IMAGE_TAG"'
                sh 'docker push "$REGISTRY/expense-frontend:$IMAGE_TAG"'
            }
        }

        stage('Deploy') {
            when { expression { params.DEPLOY } }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ec2-deploy-key',
                                                   keyFileVariable: 'SSH_KEY'),
                                 usernamePassword(credentialsId: 'ghcr',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_TOKEN'),
                                 // Bound here rather than in `environment`, so a build
                                 // that is not deploying does not require the credential.
                                 string(credentialsId: 'postgres-password',
                                        variable: 'POSTGRES_PASSWORD')]) {

                    // Jenkins already writes this 0600 on Linux; asserted anyway so a
                    // umask change cannot silently produce a key OpenSSH will refuse.
                    sh 'chmod 600 "$SSH_KEY"'

                    sh 'ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new ' +
                       '"$DEPLOY_USER@$DEPLOY_HOST" "mkdir -p ~/expense-manager"'

                    sh 'scp -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new compose.prod.yaml ' +
                       '"$DEPLOY_USER@$DEPLOY_HOST:~/expense-manager/compose.yaml"'

                    // Over stdin, never argv: argv is world-readable in `ps`.
                    // printf is a shell builtin, so these never become any process's argv either.
                    // Not a heredoc: that delimiter must sit at column 0, which no indent survives.
                    sh '''
                        printf '%s\\n' \
                            "REGISTRY=$REGISTRY" \
                            "IMAGE_TAG=$IMAGE_TAG" \
                            "PUBLIC_HOST=$DEPLOY_HOST" \
                            "JWT_SECRET=$JWT_SECRET" \
                            "JWT_EXPIRATION_HOURS=$JWT_EXPIRATION_HOURS" \
                            "POSTGRES_PASSWORD=$POSTGRES_PASSWORD" \
                          | ssh -i "$SSH_KEY" "$DEPLOY_USER@$DEPLOY_HOST" "cat > ~/expense-manager/.env"
                    '''

                    sh 'echo "$REG_TOKEN" | ssh -i "$SSH_KEY" "$DEPLOY_USER@$DEPLOY_HOST" ' +
                       '"docker login ghcr.io -u $REG_USER --password-stdin"'

                    sh 'ssh -i "$SSH_KEY" "$DEPLOY_USER@$DEPLOY_HOST" ' +
                       '"cd ~/expense-manager && docker compose pull"'

                    // Guarded: the volume is empty on a first deploy and the APIs
                    // cannot start without a database, but this wipes an existing one.
                    script {
                        if (params.SEED_REMOTE_DB) {
                            sh 'ssh -i "$SSH_KEY" "$DEPLOY_USER@$DEPLOY_HOST" ' +
                               '"cd ~/expense-manager && docker compose --profile init run --rm db-init"'
                        }
                    }

                    // --wait blocks on the same healthchecks CI used.
                    sh 'ssh -i "$SSH_KEY" "$DEPLOY_USER@$DEPLOY_HOST" ' +
                       '"cd ~/expense-manager && docker compose up -d --wait --remove-orphans"'
                }
            }
        }

        stage('Verify deployment') {
            when { expression { params.DEPLOY } }
            steps {
                // Against the public IP: proves the SG and the proxy, not just the container.
                sh 'curl --fail --silent --show-error --max-time 20 "http://$DEPLOY_HOST/api/manager/health"'
                sh 'curl --fail --silent --show-error --max-time 20 "http://$DEPLOY_HOST/api/employee/health"'
                sh 'curl --fail --silent --show-error --max-time 20 --output /dev/null "http://$DEPLOY_HOST/"'
            }
        }
    }

    post {
        always {
            // Collect evidence before `down -v` destroys what holds it.
            sh returnStatus: true,
               script: 'docker compose -f compose.yaml -f compose.ci.yaml logs --no-color > docker-logs.txt 2>&1'
            archiveArtifacts artifacts: 'docker-logs.txt', allowEmptyArchive: true

            // JMeter writes its own dashboard; Allure never sees these.
            archiveArtifacts artifacts: 'load-tests/target/jmeter/reports/**, load-tests/target/jmeter/results/*.csv',
                             allowEmptyArchive: true

            // returnStatus so teardown failure cannot mask the real one.
            sh returnStatus: true,
               script: 'docker compose -f compose.yaml -f compose.ci.yaml down -v --remove-orphans'

            // Not part of the compose project, so `down -v` does not reach it.
            sh returnStatus: true, script: 'docker rm -f "$TEST_DB_NAME"'

            junit allowEmptyResults: true,
                  testResults: 'manager-app/target/surefire-reports/*.xml, e2e-tests/target/surefire-reports/*.xml, pytest-results.xml'

            allure commandline: 'allure',
                   includeProperties: false,
                   jdk: '',
                   results: [[path: 'allure-results']]
        }
    }
}
