pipeline {
    agent any

    environment {
        // The stack publishes its ports on the Docker host, which from inside
        // this container is the default gateway. Resolved at run time because
        // the address changes if the jenkins-net network is recreated.
        HOST_ADDRESS = "${sh(returnStdout: true, script: 'set -- $(ip route | grep default); echo $3').trim()}"
        // Fixed project name so each build replaces the last stack instead of
        // colliding on ports 5000/7001/5173.
        COMPOSE_PROJECT_NAME = 'p1group6'
        // The stack is deployed from here rather than from the Jenkins
        // workspace, which lives in a named volume the host cannot see.
        CI_WORKSPACE = '/opt/ci-workspace'
        // AppConfig requires these at import time, and .env is gitignored so it
        // never reaches the workspace. Throwaway values, same as docker-compose.
       T_EXPIRATION_HOURS = '24' JWT_SECRET = 'ci-only-secret'
        JW
    }

    stages {
        stage('Employee Tests') {
            steps {
                // All three suites append to one allure-results directory and
                // the workspace survives between builds, so last run's results
                // have to go before this one starts writing.
                sh 'rm -rf allure-results htmlcov reports'
                // Debian's pip is "externally managed" (PEP 668), so a venv is
                // required — you can't pip install into the system Python.
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install --quiet -r requirements.txt
                    .venv/bin/pytest -m "not contract" --junitxml=reports/pytest.xml
                '''
            }
        }

        stage('Manager Tests') {
            steps {
                dir('manager-app') {
                    sh 'mvn -B clean package'
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd "$CI_WORKSPACE" && docker compose down -v || true
                '''
                sh '''
                    # Empty the directory rather than removing it: it is a bind
                    # mount, so deleting the mountpoint itself fails with EBUSY.
                    mkdir -p "$CI_WORKSPACE"
                    find "$CI_WORKSPACE" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
                    cp -a . "$CI_WORKSPACE/"
                    cd "$CI_WORKSPACE"
                    docker compose up -d --build
                '''
                sh '''
                    for i in $(seq 1 60); do
                        curl -sf -o /dev/null http://$HOST_ADDRESS:5173/ \
                        && curl -s -o /dev/null http://$HOST_ADDRESS:7001/ \
                        && curl -sf -o /dev/null -X POST http://$HOST_ADDRESS:5000/auth/login \
                               -H "Content-Type: application/json" \
                               -d '{"username":"brian","password":"password"}' \
                        && exit 0
                        sleep 2
                    done
                    echo "stack did not become ready in 120s"
                    cd "$CI_WORKSPACE" && docker compose logs --tail=50
                    exit 1
                '''
            }
        }

        stage('E2E Tests') {
            steps {
                dir('e2e-tests') {
                    sh '''
                        mvn -B test \
                            -De2e.headless=true \
                            -De2e.base.url=http://$HOST_ADDRESS:5173/ \
                            -De2e.employee.api=http://$HOST_ADDRESS:5000 \
                            -De2e.db.path=$CI_WORKSPACE/database/expense_manager.db
                    '''
                }
            }
        }
    }

    // always, not success: a failed suite is exactly when the report matters.
    post {
        always {
            junit allowEmptyResults: true,
                  testResults: 'reports/pytest.xml, **/target/surefire-reports/*.xml'

            allure includeProperties: false, results: [[path: 'allure-results']]

            publishHTML target: [reportName: 'Python Coverage',
                                 reportDir: 'htmlcov',
                                 reportFiles: 'index.html',
                                 allowMissing: true,
                                 keepAll: true,
                                 alwaysLinkToLastBuild: true]

            publishHTML target: [reportName: 'Java Coverage',
                                 reportDir: 'manager-app/target/site/jacoco',
                                 reportFiles: 'index.html',
                                 allowMissing: true,
                                 keepAll: true,
                                 alwaysLinkToLastBuild: true]
        }
    }
}
